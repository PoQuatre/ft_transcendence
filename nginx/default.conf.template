log_format json escape=json
	'{'
		'"time":"$time_iso8601",'
		'"remote_addr":"$remote_addr",'
		'"remote_user":"$remote_user",'
		'"request":"$request",'
		'"status":$status,'
		'"body_bytes_sent":$body_bytes_sent,'
		'"http_referer":"$http_referer",'
		'"http_user_agent":"$http_user_agent",'
		'"http_x_forwarded_for":"$http_x_forwarded_for"'
	'}';

access_log /var/log/nginx/access.log json;

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen ${PORT} default_server;
    server_name ${SERVER_NAME};

    location = /healthz {
        access_log off;
        return 200 "OK";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen ${SSL_PORT} ssl;
    server_name ${SERVER_NAME};

    set_real_ip_from frontend;
    real_ip_header X-Forwarded-For;

    ssl_certificate ${SSL_CERT_FILE};
    ssl_certificate_key ${SSL_CERT_KEY_FILE};
    ssl_protocols ${SSL_PROTOCOLS};
    ssl_ciphers ${SSL_CIPHERS};
    ssl_stapling ${SSL_OCSP_STAPLING};
    ssl_stapling_verify ${SSL_OCSP_STAPLING};

    client_max_body_size 1m;
    include includes_custom/app-routes.conf;
    include includes/location_common.conf;
}

server {
    listen ${PROXY_PROTOCOL_PORT} ssl proxy_protocol;
    server_name ${SERVER_NAME};

    set_real_ip_from ${HOSTNAME};
    real_ip_header proxy_protocol;

    ssl_certificate ${SSL_CERT_FILE};
    ssl_certificate_key ${SSL_CERT_KEY_FILE};
    ssl_protocols ${SSL_PROTOCOLS};
    ssl_ciphers ${SSL_CIPHERS};
    ssl_stapling ${SSL_OCSP_STAPLING};
    ssl_stapling_verify ${SSL_OCSP_STAPLING};

    client_max_body_size 1m;
    include includes_custom/app-routes.conf;
    include includes/location_common.conf;
}
