ARG VAULT_VERSION=2.1.1



# ------------------------------------------------------------------------------
# Vault server
# ------------------------------------------------------------------------------
FROM docker.io/hashicorp/vault:${VAULT_VERSION} AS server

# Docker and Podman copy this pre-owned directory into a new named volume.
USER 0
RUN mkdir -p /vault/data && \
	chown 100:1000 /vault/data && \
	chmod 0700 /vault/data
USER 100:1000



# ------------------------------------------------------------------------------
# Nginx PKI agent
# ------------------------------------------------------------------------------
FROM docker.io/hashicorp/vault:${VAULT_VERSION} AS nginx-agent

USER 0
RUN mkdir -p /vault/file /run/nginx-tls && \
	chown -R 100:1000 /vault/file /run/nginx-tls && \
	chmod 0700 /vault/file && \
	chmod 0755 /run/nginx-tls

COPY --chown=100:1000 nginx-agent.hcl /vault/config/nginx-agent.hcl
COPY --chown=100:1000 nginx-agent.sh /usr/local/bin/nginx-vault-agent
COPY --chown=100:1000 install-nginx-pki.sh /usr/local/bin/install-nginx-pki

RUN chmod 0555 /usr/local/bin/nginx-vault-agent /usr/local/bin/install-nginx-pki

USER 100:1000

ENTRYPOINT ["/usr/local/bin/nginx-vault-agent"]



# ------------------------------------------------------------------------------
# Bootstrap runtime base
# ------------------------------------------------------------------------------
FROM docker.io/hashicorp/vault:${VAULT_VERSION} AS bootstrap-base

# These are the targets of the bootstrap and credential named volumes.
USER 0
RUN apk add --no-cache bash=5.3.9-r1 curl=8.22.0-r0 jq=1.8.2-r0 && \
	mkdir -p /bootstrap /certs /credentials/backend /credentials/migrate /credentials/nginx-pki /credentials/pgweb && \
	chown 1000:1000 /bootstrap /certs /credentials /credentials/backend /credentials/migrate /credentials/nginx-pki /credentials/pgweb && \
	chmod 0700 /bootstrap && \
	chmod 0750 /credentials /credentials/backend /credentials/migrate /credentials/nginx-pki /credentials/pgweb
USER 1000:1000



# ------------------------------------------------------------------------------
# Development runtime
# ------------------------------------------------------------------------------
FROM bootstrap-base AS dev

COPY bootstrap.sh /usr/local/bin/bootstrap.sh

ENTRYPOINT ["bash", "/usr/local/bin/bootstrap.sh"]



# ------------------------------------------------------------------------------
# Production runtime
# ------------------------------------------------------------------------------
FROM bootstrap-base AS prod

ENV POLICIES_DIR=/etc/vault/policies

COPY bootstrap.sh /usr/local/bin/bootstrap.sh
COPY policies /etc/vault/policies

ENTRYPOINT ["bash", "/usr/local/bin/bootstrap.sh"]
