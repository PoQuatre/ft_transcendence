ARG VAULT_VERSION=2.1.1



# ------------------------------------------------------------------------------
# Vault server
# ------------------------------------------------------------------------------
FROM hashicorp/vault:${VAULT_VERSION} AS server

# Docker and Podman copy this pre-owned directory into a new named volume.
USER 0
RUN mkdir -p /vault/data && \
	chown 100:1000 /vault/data && \
	chmod 0700 /vault/data
USER 100:1000



# ------------------------------------------------------------------------------
# Bootstrap runtime base
# ------------------------------------------------------------------------------
FROM hashicorp/vault:${VAULT_VERSION} AS bootstrap-base

# These are the targets of the bootstrap and credential named volumes.
USER 0
RUN apk add --no-cache bash=5.3.9-r1 curl=8.22.0-r0 jq=1.8.2-r0 && \
	mkdir -p /bootstrap /credentials/backend /credentials/migrate /credentials/pgweb && \
	chown 1000:1000 /bootstrap /credentials /credentials/backend /credentials/migrate /credentials/pgweb && \
	chmod 0700 /bootstrap && \
	chmod 0750 /credentials /credentials/backend /credentials/migrate /credentials/pgweb
USER 1000:1000



# ------------------------------------------------------------------------------
# Development runtime
# ------------------------------------------------------------------------------
FROM bootstrap-base AS dev

COPY bootstrap.sh /usr/local/bin/bootstrap.sh

ENTRYPOINT ["bash", "/usr/local/bin/bootstrap.sh"]



# ------------------------------------------------------------------------------
# Production runtime
# ------------------------------------------------------------------------------
FROM bootstrap-base AS prod

ENV POLICIES_DIR=/etc/vault/policies

COPY bootstrap.sh /usr/local/bin/bootstrap.sh
COPY policies /etc/vault/policies

ENTRYPOINT ["bash", "/usr/local/bin/bootstrap.sh"]
