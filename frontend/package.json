{
  "name": "frontend",
  "type": "module",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.server.json",
    "dev": "vite",
    "format": "oxfmt --check .",
    "format-fix": "oxfmt --write .",
    "lint": "oxlint -c oxlint.config.ts .",
    "lint-fix": "oxlint -c oxlint.config.ts --fix .",
    "serve": "node dist/adapter/server.js",
    "start": "vite",
    "test": "vitest"
  },
  "dependencies": {
    "@solidjs/meta": "^2.0.0",
    "@solidjs/router": "^2.0.1",
    "@solidjs/web": "^2.0.3",
