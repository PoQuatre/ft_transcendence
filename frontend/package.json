    "clsx": "^2.1.1",
    "sirv": "^3.0.2",
    "solid-js": "^2.0.3",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@solidjs/diagnostics": "^2.0.3",
    "@solidjs/start-devtools": "github:solidjs/solid-start-devtools#341960b47ce45fb17526addc08c5e781983784f4",
    "@solidjs/testing-library": "^1.0.0-rc.2",
    "@solidjs/vite-plugin": "^3.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@types/node": "^26.6.6",
    "eslint-plugin-solid": "~0.20.1",
    "filesystem-routing": "0.5.0",
    "jsdom": "^31.0.1",
    "oxfmt": "^0.79.0",
    "oxlint": "~1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
