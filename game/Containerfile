ARG EMSCRIPTEN_VERSION=6.0.9



# ------------------------------------------------------------------------------
# Development runtime
# ------------------------------------------------------------------------------
FROM docker.io/emscripten/emsdk:${EMSCRIPTEN_VERSION} AS dev

RUN apt-get update && \
	apt-get install --no-install-recommends -y ninja-build inotify-tools && \
	rm -rf /var/lib/apt/lists/* && \
	mkdir -p /home/app

WORKDIR /app

COPY dev.sh /usr/local/bin/dev.sh

ENV HOME=/home/app

CMD ["sh", "/usr/local/bin/dev.sh"]
